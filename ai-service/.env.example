# AI Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# Supabase Configuration (copy from main .env.local)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Detection Configuration
MIN_CONFIDENCE=0.50
MAX_VIDEO_SIZE_MB=100
SUPPORTED_VIDEO_FORMATS=.mp4,.avi,.mov,.mkv
FRAME_SAMPLE_RATE=30

# Model Configuration
# Vehicle detection: YOLOv8 (built-in, ready to use)
VEHICLE_MODEL=yolov8n.pt
VEHICLE_DETECTION_ENABLED=true

# Road damage detection: Requires custom model
# Set ROAD_DAMAGE_MODEL path when model is available
ROAD_DAMAGE_MODEL=
ROAD_DAMAGE_DETECTION_ENABLED=false

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
EVIDENCE_DIR=./output/evidence
