# Supabase Configuration
# Get these from your Supabase project settings (https://app.supabase.com)
# Settings > API

# Public variables (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only variables (NEVER expose to the browser)
# Used for admin operations that bypass Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/app/apikey)
# SERVER-ONLY: This key must only be used in server-side code (API routes, server actions)
GEMINI_API_KEY=your-gemini-api-key-here
